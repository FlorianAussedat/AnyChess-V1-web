{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "ANYCHESS_VARIANT": "development",
        "EXPO_PUBLIC_APP_CLIENT": "dev",
        "EXPO_PUBLIC_AUTH_CONFIRM_URL": "https://sparkly-paprenjak-65f499.netlify.app/auth/confirm"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug",
        "withoutCredentials": true
      }
    },
    "stable": {
      "developmentClient": false,
      "distribution": "internal",
      "channel": "stable",
      "env": {
        "ANYCHESS_VARIANT": "stable",
        "EXPO_PUBLIC_APP_CLIENT": "app",
        "EXPO_PUBLIC_AUTH_CONFIRM_URL": "https://sparkly-paprenjak-65f499.netlify.app/auth/confirm"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      }
    },
    "standalone": {
      "developmentClient": false,
      "distribution": "internal",
      "channel": "standalone",
      "env": {
        "ANYCHESS_VARIANT": "standalone"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      }
    },
    "preview": {
      "developmentClient": false,
      "environment": "preview",
      "distribution": "internal",
      "channel": "preview",
      "credentialsSource": "remote",
      "env": {
        "ANYCHESS_VARIANT": "preview",
        "EXPO_PUBLIC_APP_CLIENT": "preview",
        "EXPO_PUBLIC_AUTH_CONFIRM_URL": "https://sparkly-paprenjak-65f499.netlify.app/auth/confirm",
        "ANYCHESS_PREVIEW_EAS_OWNER": "anychess",
        "ANYCHESS_PREVIEW_EAS_PROJECT_ID": "f42b44f4-73ce-4752-82d9-38d12f094d55"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a"
      }
    }
  }
}
