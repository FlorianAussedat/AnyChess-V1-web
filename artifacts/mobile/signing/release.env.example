# Copy this file to artifacts/mobile/.signing/release.env
# That directory is gitignored. Keep the file mode at 0600.
# Store the .jks itself outside the git repository.
#
# ANYCHESS_RELEASE_STORE_FILE=/absolute/path/outside-android/anychess-stable-release.jks
# ANYCHESS_RELEASE_STORE_PASSWORD=
# ANYCHESS_RELEASE_KEY_ALIAS=
# ANYCHESS_RELEASE_KEY_PASSWORD=
#
# The public certificate of that keystore must match
# signing/standalone-release-cert.json before a standalone build is allowed.
# Generating a new keystore will not update the installed application.
