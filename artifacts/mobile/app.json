{
  "expo": {
    "name": "AnyChess",
    "slug": "mobile",
    "version": "0.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1728"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "userInterfaceStyle": "dark"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "AnyChess a besoin du microphone pour reconnaître vos coups d'échecs.",
          "speechRecognitionPermission": "AnyChess a besoin de la reconnaissance vocale pour jouer aux échecs."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
