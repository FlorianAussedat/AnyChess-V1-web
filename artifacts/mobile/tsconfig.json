{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "lib/voice/__tests__/**",
    "lib/app/__tests__/**",
    "lib/continueLine/__tests__/**",
    "lib/mentalPosition/__tests__/**",
    "lib/moveNaming/__tests__/**",
    "lib/openingQuiz/__tests__/**"
  ],
  "references": [
    {
      "path": "../../lib/api-client-react"
    }
  ]
}
